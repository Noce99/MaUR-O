<?xml version="1.0" encoding="UTF-8"?>
<!--
  A symbol set for the map generator: two opaque areas whose fill patterns
  turn with the object they are drawn on, and one which has no pattern to
  turn. The map scale is 1:10000, and nothing is drawn on it -- only the
  symbols are used.
-->
<map xmlns="http://openorienteering.org/apps/mapper/xml/v2" version="9">
<notes></notes>
<georeferencing scale="10000">
 <ref_point x="0" y="0"/>
</georeferencing>
<colors count="3">
 <color priority="0" name="Black" c="0" m="0" y="0" k="1" opacity="1"><rgb method="cmyk" r="0" g="0" b="0"/></color>
 <color priority="1" name="Green" c="0.76" m="0" y="0.91" k="0" opacity="1"><rgb method="cmyk" r="0" g="0.79" b="0.34"/></color>
 <color priority="2" name="Yellow" c="0" m="0.27" y="0.79" k="0" opacity="1"><rgb method="cmyk" r="1" g="0.79" b="0.15"/></color>
</colors>
<barrier version="6" required="0.6.0">
 <symbols count="3" id="">
  <symbol type="4" id="0" code="401" name="Open land">
   <area_symbol inner_color="2" min_area="0" patterns="0"/>
  </symbol>
  <symbol type="4" id="1" code="403" name="Rough open land with scattered trees">
   <area_symbol inner_color="2" min_area="0" patterns="1">
    <pattern type="2" angle="0" rotatable="true" line_spacing="3000" line_offset="0" offset_along_line="0" point_distance="3000">
     <symbol type="1" id="" code="" name="Scattered tree">
      <point_symbol rotatable="false" inner_radius="600" inner_color="1" outer_width="0" outer_color="-1" elements="0"/>
     </symbol>
    </pattern>
   </area_symbol>
  </symbol>
  <symbol type="4" id="2" code="407" name="Rough open land with undergrowth">
   <area_symbol inner_color="2" min_area="0" patterns="1">
    <pattern type="1" angle="0" rotatable="true" line_spacing="1500" line_offset="0" offset_along_line="0" color="1" line_width="300"/>
   </area_symbol>
  </symbol>
 </symbols>
</barrier>
<parts count="1" current="0">
 <part name="default">
  <objects count="0">
  </objects>
 </part>
</parts>
</map>
